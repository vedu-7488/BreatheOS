# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model identifier (never hardcoded as preview).
GEMINI_MODEL="gemini-4-hydrogen"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key (also accepted via GOOGLE_MAPS_API_KEY on server).
VITE_GOOGLE_MAPS_API_KEY=""

# OPENAQ_API_KEY: Optional OpenAQ v3 API key for physical station telemetry.
OPENAQ_API_KEY=""

# JWT_SECRET: Signing secret for BreatheOS session tokens.
JWT_SECRET="breatheos-dev-session-secret-change-in-prod"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
